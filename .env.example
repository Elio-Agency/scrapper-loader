# Copy to .env and fill in. Leave PROXY_SERVER empty to go direct.

# Local intermediate (run: python start_proxy.py)
PROXY_SERVER=http://127.0.0.1:8888
PROXY_USERNAME=
PROXY_PASSWORD=

# Real intermediate later, e.g.:
# PROXY_SERVER=http://host:port
# PROXY_USERNAME=user
# PROXY_PASSWORD=pass

DUCKDB_PATH=booking.duckdb
